# 1. Local Python AI Backend
AI_API_HOST=127.0.0.1
AI_API_PORT=8000
AI_API_SECRET_TOKEN=smartclassroom-secure-ipc-token-2026

# 2. Camera Configuration
DEFAULT_CAMERA_PROVIDER=MOCK
RTSP_CAMERA_URL=rtsp://192.168.1.100:554/live/ch0
