{
  "name": "smartclassroom-ai-attendance",
  "version": "1.0.0",
  "description": "SmartClassroom AI Attendance System Desktop Application",
  "main": "desktop/electron/main.js",
  "scripts": {
    "postinstall": "npm --prefix desktop/frontend install",
    "dev:frontend": "npm --prefix desktop/frontend run dev",
    "build:frontend": "npm --prefix desktop/frontend run build",
    "start:backend": "python -m ai_engine.api.main",
    "start:electron": "electron desktop/electron/main.js",
    "test:backend": "python -m pytest tests/",
    "pack:win": "electron-builder --win"
  },
  "dependencies": {
    "electron-is-dev": "^3.0.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.2"
  }
}
